{
  "name": "@regenic/whatsapp-personal",
  "version": "0.1.0",
  "private": true,
  "regenic": {
    "plugin": true,
    "catalogOrder": 50,
    "id": "@regenic/whatsapp-personal",
    "displayName": "WhatsApp",
    "engines": {
      "regenic": "1.0"
    },
    "contributes": {
      "drivers": [
        "whatsappWebLiveDriver",
        "whatsappLinkedDeviceDriver"
      ]
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "prebuild": "node scripts/link-regenic-contract.mjs",
    "build": "tsc -p tsconfig.json",
    "build:sidecar": "node scripts/build-whatsapp-sidecar.mjs",
    "prepack": "pnpm run build && pnpm run build:sidecar",
    "pretest": "node scripts/link-regenic-contract.mjs",
    "test": "pnpm run build && node --test test/*.test.cjs",
    "pretypecheck": "node scripts/link-regenic-contract.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "csv-parse": "7.0.2"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2",
    "@regenic/connector-test-utils": "^0.1.0",
    "@regenic/connector-contract": "^0.1.0"
  },
  "files": [
    "dist",
    "bin",
    "THIRD_PARTY_NOTICES.md"
  ],
  "peerDependencies": {
    "@regenic/connector-contract": "^0.1.0"
  }
}
